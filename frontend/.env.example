# Copy this file to .env (and/or .env.local) and fill in real values.
# Never commit the real .env — see root .gitignore.

# Base path the frontend calls for the backend API. Keep as /api to use the
# nginx (prod) / Vite dev-server (local) reverse proxy; only use a full
# https:// URL here if you intend to call the backend directly, bypassing the proxy.
VITE_API_BASE_URL=/api

# Backend origin the local Vite dev server proxies /api requests to.
# Point this at your own backend (Cloud Run URL or http://localhost:8080).
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Okta SPA app values for your environment/tenant.
VITE_OKTA_CLIENT_ID=YOUR_OKTA_CLIENT_ID
VITE_OKTA_ISSUER=https://YOUR_OKTA_DOMAIN/oauth2/default
# Leave empty when the backend uses the confirmed application-assignment policy.
VITE_OKTA_API_SCOPES=
