server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Single source of truth for CSP so it isn't duplicated verbatim in every
    # location block below (nginx `set` variables ARE inherited into child
    # locations even though `add_header` directives are not).
    set $csp_policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.okta.com https://*.oktapreview.com; frame-src 'self' https://*.okta.com https://*.oktapreview.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests;";

    # Applies here + to /api/ (inherited, since that location sets no add_header
    # of its own). Locations below that already set add_header for caching
    # must repeat these — nginx drops inherited add_header once a location
    # defines any add_header itself.
    add_header Content-Security-Policy $csp_policy always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Compress text-based responses (JS/CSS/JSON/SVG etc.) before sending over
    # the wire — the 1MB+ JS bundle shrinks substantially, cutting data moved
    # per request under concurrent load.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/xml+rss
        application/atom+xml
        image/svg+xml
        font/woff2;

    # Proxy all API requests to the backend Cloud Run service.
    # BACKEND_ORIGIN is substituted from the container's environment at startup
    # (nginx:alpine templating) — set it via `docker run -e` or Cloud Run
    # `--set-env-vars`; never hardcode an environment-specific URL here.
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        # Nginx defaults to 1m and silently 413s any larger upload (e.g. document
        # uploads) before it ever reaches the backend. 0 disables the size cap.
        client_max_body_size 0;
        # Default "on" makes nginx fully buffer (RAM/temp-file) the whole
        # request body before it starts forwarding to the backend, effectively
        # doubling large-upload latency (receive-then-forward instead of
        # streaming). Off streams bytes to the backend as they arrive.
        proxy_request_buffering off;
    }

    # Serve static files, fallback to index.html for SPA routing
    # Ensure index.html is never cached (always fetch latest)
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        add_header Content-Security-Policy $csp_policy always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Content-Security-Policy $csp_policy always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }

    # Cache static assets (hashed filenames handle cache busting)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Content-Security-Policy $csp_policy always;
        add_header X-Frame-Options "DENY" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()" always;
        add_header X-XSS-Protection "1; mode=block" always;
    }
}
